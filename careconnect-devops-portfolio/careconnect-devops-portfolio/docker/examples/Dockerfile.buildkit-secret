# syntax=docker/dockerfile:1
# BuildKit secret mount: the secret is available ONLY during this RUN and is never stored in an image layer.
#   echo "s3cr3t-token" > /tmp/token.txt
#   docker build --secret id=api_token,src=/tmp/token.txt -f docker/examples/Dockerfile.buildkit-secret -t secret-demo docker/examples
#   docker history secret-demo      # the token is not in any layer
FROM alpine:3.20
RUN --mount=type=secret,id=api_token \
    test -s /run/secrets/api_token && echo "secret was available, length $(wc -c < /run/secrets/api_token)"
